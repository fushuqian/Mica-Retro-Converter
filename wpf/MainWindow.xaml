<ui:FluentWindow x:Class="Win98Converter.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Win98 ASF 视频转换器"
                 Width="1060" Height="720"
                 MinWidth="880" MinHeight="600"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Win98 ASF 视频转换器">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                    <ui:Button Icon="{ui:SymbolIcon WeatherMoon24}" Appearance="Transparent"
                               ToolTip="切换深色/浅色主题" Click="ToggleTheme_Click" />
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="16,4,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="170" />
                </Grid.RowDefinitions>

                <Border x:Name="DropZone" AllowDrop="True" Padding="20" CornerRadius="8"
                        BorderThickness="1"
                        Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}"
                        Drop="DropZone_Drop" DragOver="DropZone_DragOver">
                    <StackPanel HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="26" HorizontalAlignment="Center" />
                        <TextBlock Text="拖拽视频文件或文件夹到这里" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        <Button Content="选择文件..." Click="BrowseFiles_Click" HorizontalAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <ListView x:Name="FileListView" Grid.Row="1" Margin="0,10,0,0"
                          KeyDown="FileListView_KeyDown"
                          HorizontalContentAlignment="Stretch"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" BorderThickness="1" Padding="12,10"
                                    Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}"
                                    ToolTip="{Binding FullPath}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Info}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"
                                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding Status}" FontSize="12">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="转换中">
                                                                <Setter Property="Foreground" Value="{ui:ThemeResource SystemAccentColorPrimaryBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="完成">
                                                                <Setter Property="Foreground" Value="{ui:ThemeResource SystemFillColorSuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="失败">
                                                                <Setter Property="Foreground" Value="{ui:ThemeResource SystemFillColorCriticalBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding ProgressText}" FontSize="12" Margin="8,0,0,0"
                                                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Delete24}" Appearance="Transparent"
                                               VerticalAlignment="Top" ToolTip="从列表移除" Click="RemoveFile_Click" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBox x:Name="LogBox" Grid.Row="2" Margin="0,10,0,0" IsReadOnly="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="12"
                         Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}" />
            </Grid>

            <Border Grid.Column="1" CornerRadius="8" BorderThickness="1" Padding="16"
                    Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="转换设置" FontSize="14" FontWeight="SemiBold" />

                        <TextBlock Text="预设" Margin="0,12,0,4" />
                        <ComboBox x:Name="PresetCombo" HorizontalAlignment="Stretch"
                                  DisplayMemberPath="Display"
                                  SelectionChanged="PresetCombo_SelectionChanged">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                    <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>
                        <TextBlock x:Name="PresetDescText" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"
                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />

                        <TextBlock Text="帧率（预设强制帧率时忽略）" Margin="0,12,0,4" />
                        <ComboBox x:Name="FpsCombo" HorizontalAlignment="Stretch" DisplayMemberPath="Label" />

                        <CheckBox x:Name="LetterboxCheck" Content="Letterbox 4:3 加黑边（推荐）" IsChecked="True" Margin="0,12,0,0" />
                        <CheckBox x:Name="BurnSubCheck" Content="烧录同名字幕 (.srt/.ass/.ssa/.sub)" IsChecked="True" />

                        <TextBlock Text="输出目录（留空 = 源文件同目录）" Margin="0,12,0,4" />
                        <TextBox x:Name="OutputDirBox" />

                        <ui:Button x:Name="StartButton" Content="开始转换" Appearance="Primary"
                                   Icon="{ui:SymbolIcon Play24}"
                                   HorizontalAlignment="Stretch" Margin="0,16,0,0" Click="Start_Click" />
                        <ui:Button x:Name="CancelButton" Content="取消" IsEnabled="False"
                                   Icon="{ui:SymbolIcon Stop24}"
                                   HorizontalAlignment="Stretch" Margin="0,8,0,0" Click="Cancel_Click" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="16,0,16,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="TotalProgress" Height="6" VerticalAlignment="Center" />
            <TextBlock x:Name="ProgressText" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Text="0%" />
        </Grid>

        <ui:SnackbarPresenter x:Name="MainSnackbar" Grid.Row="0" Grid.RowSpan="3" />
    </Grid>
</ui:FluentWindow>
