{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "Default capabilities for the main window",
    "windows": [
        "main"
    ],
    "permissions": [
        "core:window:default",
        "core:window:allow-start-dragging",
        "core:window:allow-set-always-on-top",
        "core:webview:default",
        "core:default"
    ]
}